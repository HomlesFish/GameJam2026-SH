%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1f85dcf0077142e3a401c0dab54eda6c, type: 3}
  m_Name: SubtitleDatabase
  m_EditorClassIdentifier: 
  entries:
  - id: 1001
    text: 123456
    voice: {fileID: 0}
  - id: HarborNoObjective
    text: "\u672A\u83B7\u5F97\u4E3B\u8981\u7269\u54C1\uFF0C\u65E0\u6CD5\u8FDB\u884C\u7ED3\u7B97"
    voice: {fileID: 0}
  - id: NearTarget
    text: "\u5DF2\u5728\u76EE\u6807\u9644\u8FD1"
    voice: {fileID: 0}
  - id: HitReef
    text: "\u4F60\u5DF2\u89E6\u7901"
    voice: {fileID: 0}
  - id: DepthChargeLaunched
    text: "\u6210\u529F\u53D1\u5C04"
    voice: {fileID: 0}
  - id: Anchored
    text: "\u8239\u951A\u5230\u8FBE\u6D77\u5E95"
    voice: {fileID: 0}
  - id: BombedFish
    text: "\u5DF2\u70B8\u5230\u9C7C\u7FA4"
    voice: {fileID: 0}
  - id: BombedReef
    text: "\u5DF2\u70B8\u5230\u6697\u7901"
    voice: {fileID: 0}
  - id: L1_01
    text: "\u6545\u969C\u2014\u2014\u7535\u53F0\u7A81\u7136\u64AD\u653E\u65E0\u5173\u7247\u6BB5"
    voice: {fileID: 0}
  - id: L1_02
    text: "\u3010\u5973\u58F0\uFF08\u5E74\u8F7B\uFF0C\u5E26\u7B11\uFF09\uFF1A\u201C\u94ED\u724C\u4E0A\u523B\u4E86\u5B57\uFF1F......\u6211\u770B\u770B......'\u613F\u4F60\u627E\u5230\u5F52\u8DEF'......\u4F60\u5199\u7684\uFF1F\u201D\u3011"
    voice: {fileID: 0}
  - id: L1_03
    text: "\u523A\u5566\u7684\u7535\u6D41\u58F0\u54CD\u8FC7\uFF0C\u7535\u53F0\u5207\u56DE\u6B63\u5E38\uFF1A"
    voice: {fileID: 0}
  - id: L1_04
    text: "\u8239\u957F\uFF1A\u201C\u8FD9\u662F\u4E00\u4E2A\u94ED\u724C\u540A\u5760\u3002\u6709\u70B9\u65E7\u4E86\u3002\u201D"
    voice: {fileID: 0}
  - id: L1_05
    text: "\u8239\u957F\uFF1A\u201C\u94ED\u724C\u5E95\u90E8\u523B\u7740\u5B57\uFF1A\u201C\u7ED9J\uFF0C\u613F\u4F60\u627E\u5230\u5F52\u8DEF\u3002\u2014\u2014L\u201D\u201D"
    voice: {fileID: 0}
  - id: L1_06
    text: "\u8239\u957F\uFF1A\u201C\u8FD9\u662F\u4E00\u4E2A\u4E0D\u9508\u94A2\u8D28\u5730\u7684\u94ED\u724C\u3002\u770B\u8D77\u6765\u6CA1\u4EC0\u4E48\u4EF7\u503C\u3002\u201D"
    voice: {fileID: 0}
  - id: L2_01
    text: "\u6545\u969C\u2014\u2014\u7535\u53F0\u7A81\u7136\u64AD\u653E\u65E0\u5173\u7247\u6BB5"
    voice: {fileID: 0}
  - id: L2_02
    text: "\u3010\uFF08\u2014\u2014\u4E00\u6BB5\u5608\u6742\u7684\u80CC\u666F\u73AF\u5883\u97F3\u3002\u7D27\u63A5\u7740\u54CD\u8D77\u4E86\u4E00\u6BB5\u5BF9\u8BDD\u3002\uFF09\u3011"
    voice: {fileID: 0}
  - id: L2_03
    text: "A\uFF1A\u201C\u2026\u2026\u8FD9\u91CC\u592A\u9760\u8FD1\u6838\u5FC3\u4E86\uFF0C\u6838\u8F90\u5C04\u7684\u5F71\u54CD\u8D8A\u6765\u8D8A\u4E25\u91CD\u4E86\u3002\u4E0A\u5934\u7684\u64A4\u79BB\u4EE4\u4E0B\u6765\u4E86\u2026\u2026\u201D"
    voice: {fileID: 0}
  - id: L2_04
    text: "B\uFF1A\u201C\u6797\u526F\u961F\u957F\u5462\uFF1F\u201D"
    voice: {fileID: 0}
  - id: L2_05
    text: "A\uFF1A\u201C\u4ED6\u4E0D\u8D70\uFF0C\u4ED6\u8BF4\u8981\u7B49\u5A55\u56DE\u6765\u3002\u201D"
    voice: {fileID: 0}
  - id: L2_06
    text: "B\uFF1A\u201C\u5979\u4E0B\u6F5C\u7684\u592A\u6DF1\u4E86......\u201D"
    voice: {fileID: 0}
  - id: L2_07
    text: "\uFF08\u5F55\u97F3\u7B52\u54CD\u8D77\u4E86\u548C\u8239\u957F\u58F0\u97F3\u4E00\u81F4\u7684\u7537\u58F0\uFF0C\u4F46\u4E0D\u540C\u4E4B\u5904\u662F\uFF0C\u8FD9\u4E2A\u58F0\u97F3\u542C\u8D77\u6765\u5F02\u5E38\u75B2\u60EB\u3002\uFF09"
    voice: {fileID: 0}
  - id: L2_08
    text: "\u201C\u6211\u662F\u6797\u3002\u8FD9\u662F\u7B2C23\u65E5\u3002\u4ECA\u5929\u8F90\u5C04\u91CF\u603B\u91CF\u7EA6\u4E3A110
      \xB5Sv\u3002\u201D"
    voice: {fileID: 0}
  - id: L2_09
    text: "\u201C\u6211\u80FD\u611F\u89C9\u5230\uFF0C\u6211\u5DF2\u7ECF\u53D7\u8F90\u5C04\u5F71\u54CD\uFF0C\u5FD8\u8BB0\u4E86\u4E0A\u5468\u53D1\u751F\u7684\u4E8B\u3002\u518D\u8FD9\u4E48\u4E0B\u53BB\uFF0C\u6211\u8FD8\u4F1A\u5FD8\u8BB0\u591A\u5C11\u4E8B\uFF1F\u201D"
    voice: {fileID: 0}
  - id: L2_10
    text: "\u201C\u4F46\u6211\u81F3\u5C11\u8FD8\u8BB0\u5F97\u5979\u3002\u201D"
    voice: {fileID: 0}
  - id: L2_11
    text: "\u8239\u957F\uFF1A\u201C\u542C\u8D77\u6765\u6709\u4E9B\u60B2\u4F24\u3002\u201D"
    voice: {fileID: 0}
  - id: L3_01
    text: "\u8239\u957F\uFF1A\u201C\u8FD9\u662F\u4E00\u5F20\u9632\u6C34\u7684\u7EB8\u3002\u4E0A\u9762\u7684\u5B57\u8FF9\u8FD8\u4F9D\u7A00\u53EF\u4EE5\u8FA8\u8BA4\uFF0C\u5199\u7740\u2014\u2014\u201D"
    voice: {fileID: 0}
  - id: L3_02
    text: "'2030\u5E747\u67084\u65E5\u3002\u4E0B\u6F5C\u6DF1\u5EA6\u4E3A327\u7C73\u3002\u8F90\u5C04\u91CF\u65E0\u6CD5\u6D4B\u91CF\u3002'"
    voice: {fileID: 0}
  - id: L3_03
    text: "'\u6211\u7EC8\u4E8E\u770B\u5230\u4E86\u6838\u53CD\u5E94\u5806\uFF0C\u8FD8\u6709\u65C1\u8FB9\u7684\u6838\u6F5C\u8247\u6B8B\u9AB8\u2026\u2026\u8FD9\u91CC\u7684\u79CD\u79CD\u8FF9\u8C61\u90FD\u7B26\u5408\u4E8E\u65E7\u4E16\u7EAA\u672B\u671F\u7684\u2026\u2026\u201C\u6D77\u6E0A\u8BA1\u5212\u201D\u2026\u2026\u7B97\u662F\u7EC8\u4E8E\u6709\u7ED3\u679C\u4E86\u3002'"
    voice: {fileID: 0}
  - id: L3_04
    text: "'\u82E5\u6211\u8FF7\u5931\uFF0C\u52FF\u5BFB\u3002\u6211\u5DF2\u51B3\u5B9A\u628A\u751F\u547D\u732E\u7ED9\u4EBA\u6C11\u3002'"
    voice: {fileID: 0}
  - id: L3_05
    text: "\u7F72\u540D\u662F\u5A55\u3002\u770B\u8D77\u6765\u662F\u4E00\u4E2A\u5973\u6027\u7684\u540D\u5B57\u3002"
    voice: {fileID: 0}
  - id: L3_06
    text: "\u8239\u957F\uFF1A\u201C\u6D77\u5E95\u5F88\u5371\u9669\uFF0C\u4ECE\u7406\u6027\u7684\u89D2\u5EA6\u770B\uFF0C\u5979\u4E0D\u5E94\u8BE5\u4E0B\u6F5C\u7684\u3002\u201D"
    voice: {fileID: 0}
  - id: L4_01
    text: "\uFF08\u91D1\u5C5E\u7B52\u54CD\u8D77\u4E86\u548C\u8239\u957F\u58F0\u97F3\u4E00\u81F4\u7684\u7537\u58F0\uFF09"
    voice: {fileID: 0}
  - id: L4_02
    text: "\u201C\u6211\u662F\u6797\u3002\u8FD9\u662F\u7B2C47\u65E5\u3002\u4ECA\u5929\u8F90\u5C04\u91CF\u603B\u91CF\u7EA6\u4E3A107
      \xB5Sv\u3002\u201D"
    voice: {fileID: 0}
  - id: L4_03
    text: "\u201C\u6211\u5DF2\u7ECF\u4E0D\u8BB0\u5F97\u6628\u5929\u53D1\u751F\u7684\u4E8B\u3002\u5E76\u4E14\uFF0C\u6211\u7684\u957F\u671F\u8BB0\u5FC6\u4E5F\u5728\u6162\u6162\u6D88\u5931\u3002\u5979\u5230\u5E95\u662F\u8C01\uFF1F\u201D"
    voice: {fileID: 0}
  - id: L4_04
    text: "\u201C\u660E\u65E9\u53C8\u6709\u4E00\u6279\u64A4\u79BB\u8239\uFF0C\u4F46\u6211\u4E0D\u8D70\u3002\u6211\u8981\u7559\u5728\u8FD9\u91CC\u3002\u90A3\u4E2A\u58F0\u97F3\u8FD8\u5728\u6211\u7684\u8033\u8FB9\uFF0C\u5728\u558A\u6211\u7684\u540D\u5B57\u3002\u201D"
    voice: {fileID: 0}
  - id: L4_05
    text: "\u201C\u6211\u8981\u53BB\u627E\u5979\u3002\u201D"
    voice: {fileID: 0}
  - id: L4_06
    text: "\u8239\u957F\uFF1A\u201C\u6211\u610F\u8BC6\u5230\u8FD9\u4E2A\u8BED\u97F3\u548C\u6211\u7684\u97F3\u9891\u7D20\u6750\u9AD8\u5EA6\u76F8\u4F3C\u3002\u201D"
    voice: {fileID: 0}
  - id: L5_01
    text: "\uFF08\u5F55\u97F3\u7B52\u54CD\u8D77\u4E86\u548C\u8239\u957F\u58F0\u97F3\u4E00\u81F4\u7684\u7537\u58F0\uFF09"
    voice: {fileID: 0}
  - id: L5_02
    text: "\u201C\u6211\u5F00\u59CB\u8FDE\u6211\u81EA\u5DF1\u662F\u8C01\u90FD\u9010\u6E10\u5FD8\u8BB0\u4E86\u3002\u201D"
    voice: {fileID: 0}
  - id: L5_03
    text: "\u201C\u8FD8\u597D\u8FD9\u8258\u8239\u914D\u5907\u4E86\u667A\u80FD\u7CFB\u7EDF\uFF0C\u6211\u53EF\u4EE5\u628A\u6211\u81EA\u5DF1\u7684\u5F55\u97F3\u63A5\u5165\u7CFB\u7EDF\uFF0C\u7528\u6765\u63D0\u9192\u672A\u6765\u7684\u6211\u2014\u2014\u8BE5\u600E\u4E48\u6253\u635E\uFF0C\u600E\u4E48\u7EE7\u7EED\u5728\u8FD9\u7247\u6D77\u4E0A\u751F\u5B58\u3002\u201D"
    voice: {fileID: 0}
  - id: L5_04
    text: "\u201C\u65E0\u8BBA\u5982\u4F55\uFF0C\u6211\u4E5F\u4E0D\u80FD\u653E\u5F03\u5BFB\u627E\u90A3\u4E2A\u58F0\u97F3\u3002\u5979\u5F88\u91CD\u8981\u3002\u201D"
    voice: {fileID: 0}
  - id: BatteryEmpty
    text: "\u7535\u91CF\u8017\u5C3D\uFF0C\u5DF2\u91CD\u65B0\u8FD4\u56DE\u6E2F\u53E3"
    voice: {fileID: 0}
